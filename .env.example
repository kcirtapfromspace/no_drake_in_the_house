# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/music_blocklist
DUCKDB_PATH=./data/analytics.duckdb

# Server Configuration
SERVER_ADDRESS=0.0.0.0:3000

# Security
JWT_SECRET=your-secret-key-change-this-in-production
MIGRATION_API_KEY=replace-with-a-long-random-value

# External APIs (for future use)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
APPLE_MUSIC_TEAM_ID=your-apple-team-id
APPLE_MUSIC_KEY_ID=your-apple-key-id
CONVEX_DEPLOYMENT=
CONVEX_URL=
EXTENSION_SIGNING_PRIVATE_KEY_PEM=

# Redis (for job queues)
REDIS_URL=redis://localhost:6379

# Evidence evaluation — set these in the Convex deployment, not VITE_*.
# Use 1Password/your secret manager; never commit actual values.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
FIRECRAWL_API_KEY=
NDITH_SERVICE_KEY=
NDITH_BACKEND_URL=
# Rust research writes to Convex HTTP actions (.site, not .cloud).
CONVEX_SITE_URL=
