server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # `valid=10s` keeps the resolver cache short enough that cold-start
    # NXDOMAIN doesn't pin us to a 5xx for minutes after wake-up. The
    # `ipv6=off` is mandatory: VPC DNS will return AAAA failures that
    # otherwise spam the error log.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # When the upstream is a literal URL (`proxy_pass http://Foo;`),
    # nginx resolves it ONCE at config load and caches the result for
    # the lifetime of the process — including NXDOMAIN. With Service
    # Connect / Cloud Map this means a service that is at desiredCount=0
    # at startup is unreachable forever. Forcing re-resolution requires
    # naming the upstream via a variable (`set $u "http://Foo"; proxy_pass
    # $u;`), which makes nginx hit the resolver on every request.
    proxy_ssl_server_name on;
    proxy_ssl_name $proxy_host;

    # Intercept upstream 5xx so the @warming error_page below is used
    # for backend/analytics/graph/news cold-start failures. Without
    # this, nginx forwards upstream 5xx bodies verbatim and the user
    # sees the raw error.
    proxy_intercept_errors on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ----- Warming page ----------------------------------------------------
    # The Backend / Analytics / Graph / News services scale to zero. The
    # first request after idle hits a paused service: VPC DNS returns
    # NXDOMAIN (Cloud Map de-registers the task when desiredCount=0).
    # nginx surfaces that as 502; we intercept and serve a branded
    # warming page that auto-refreshes every 10 seconds while the
    # WakeUp Lambda boots the backend (~60-90s end-to-end).
    error_page 502 503 504 = @warming;

    location @warming {
        # 503 + Retry-After so well-behaved clients (curl, fetch with
        # auto-retry, monitoring probes) back off and retry on their own.
        # The meta-refresh covers human browsers.
        add_header Content-Type "text/html; charset=utf-8" always;
        add_header Retry-After "10" always;
        add_header Cache-Control "no-store" always;
        return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>Warming up</title><style>:root{color-scheme:light dark}html,body{margin:0;padding:0;height:100%}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;display:flex;align-items:center;justify-content:center;background:#fafafa;color:#222;line-height:1.5}main{max-width:32rem;padding:2rem;text-align:center}h1{font-size:1.5rem;font-weight:600;margin:0 0 .75rem}p{margin:0 0 .5rem;color:#555}.dot{display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:#888;margin:0 .15rem;animation:b 1.4s infinite ease-in-out both}.dot:nth-child(1){animation-delay:-.32s}.dot:nth-child(2){animation-delay:-.16s}@keyframes b{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}@media (prefers-color-scheme:dark){body{background:#0f0f10;color:#eee}p{color:#aaa}.dot{background:#bbb}}</style></head><body><main><h1>We\'re warming up</h1><p>The site scales to zero when nobody\'s visiting, and somebody just woke it up.</p><p>This page will reload itself in 10 seconds; you should see your content shortly.</p><p aria-hidden="true" style="margin-top:1.25rem"><span class="dot"></span><span class="dot"></span><span class="dot"></span></p></main><script>fetch("${WAKE_URL}",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({service:"all"}),mode:"cors",cache:"no-store"}).catch(function(){});</script></body></html>';
    }

    location = /render-health {
        access_log off;
        return 200 '{"status":"ok","service":"ndith-frontend","git_sha":"${GIT_SHA}"}';
        add_header Content-Type application/json;
    }

    # ---- Backend (api / auth / oauth / health / well-known / metrics) ----
    location = /api/health {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/health/ready {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/health/live {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health/live;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /metrics {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /metrics/prometheus {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/metrics/prometheus;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /monitoring {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/monitoring;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Analytics, Graph, News (longest prefix first) -------------------
    location = /api/v1/analytics {
        set $upstream_analytics "${ANALYTICS_UPSTREAM_URL}";
        proxy_pass $upstream_analytics$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/analytics/ {
        set $upstream_analytics "${ANALYTICS_UPSTREAM_URL}";
        proxy_pass $upstream_analytics$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location = /api/v1/graph {
        set $upstream_graph "${GRAPH_UPSTREAM_URL}";
        proxy_pass $upstream_graph$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/graph/ {
        set $upstream_graph "${GRAPH_UPSTREAM_URL}";
        proxy_pass $upstream_graph$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location = /api/v1/news {
        set $upstream_news "${NEWS_UPSTREAM_URL}";
        proxy_pass $upstream_news$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/news/ {
        set $upstream_news "${NEWS_UPSTREAM_URL}";
        proxy_pass $upstream_news$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ---- Generic /api/* fallthrough → Backend ----------------------------
    location /api/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ---- /oauth/* and /auth/callback/* must reach Backend -----------------
    # The api subdomain now routes to Frontend nginx (was direct to
    # Backend), so OAuth provider redirects (e.g. Spotify, Apple, Google,
    # GitHub) hitting /auth/callback/* MUST be proxied to Backend rather
    # than handled by the SPA. /oauth/* (legacy paths) likewise.
    location /oauth/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location /auth/callback/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # SPA-handled /auth/* (login, signup pages, etc.) — only reached when
    # the path is not /auth/callback/* (longer prefix wins).
    location /auth/ {
        try_files $uri $uri/ /index.html;
    }

    # ---- /.well-known/* — OIDC discovery, JWKS — always Backend ----------
    location /.well-known/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- /health and /health/* — Backend's "real" health endpoints ------
    # Reached when probes hit the apex/api directly without the /api
    # prefix. Forwarded to Backend via Cloud Map.
    location = /health {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # SPA catch-all — anything not matched above is the Svelte app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
