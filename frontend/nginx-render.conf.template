# Coalesce repeated cold-start probes for each configured service.
proxy_cache_path /var/cache/nginx/service-wake levels=1:2 keys_zone=service_wake:1m max_size=1m inactive=1m;
map $request_uri $wake_service {
    ~^/api/v1/news(?:/|\?|$) News;
    ~^/api/v1/analytics(?:/|\?|$) Analytics;
    ~^/api/v1/graph(?:/|\?|$) Graph;
    default Backend;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # `valid=10s` keeps the resolver cache short enough that cold-start
    # NXDOMAIN doesn't pin us to a 5xx for minutes after wake-up. The
    # `ipv6=off` is mandatory: VPC DNS will return AAAA failures that
    # otherwise spam the error log.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # When the upstream is a literal URL (`proxy_pass http://Foo;`),
    # nginx resolves it ONCE at config load and caches the result for
    # the lifetime of the process — including NXDOMAIN. With Service
    # Connect / Cloud Map this means a service that is at desiredCount=0
    # at startup is unreachable forever. Forcing re-resolution requires
    # naming the upstream via a variable (`set $u "http://Foo"; proxy_pass
    # $u;`), which makes nginx hit the resolver on every request.
    proxy_ssl_server_name on;
    proxy_ssl_name $proxy_host;

    # Intercept upstream 5xx so the warming error page below is used
    # for backend/analytics/graph/news cold-start failures. Without
    # this, nginx forwards upstream 5xx bodies verbatim and the user
    # sees the raw error.
    proxy_intercept_errors on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Wake idle services from the proxy, including fetch/Convex requests that
    # never execute JavaScript embedded in an HTML error body.
    error_page 502 503 504 =503 /__ndith/warming.html;

    location = /__ndith/warming.html {
        internal;
        alias /usr/share/nginx/warming.html;
        default_type text/html;
        add_header Retry-After "10" always;
        add_header Cache-Control "no-store" always;
        mirror /__ndith/wake;
        mirror_request_body off;
    }

    location = /__ndith/wake {
        internal;
        set $wake_url "${WAKE_URL}";
        if ($wake_url = "") { return 204; }
        proxy_pass $wake_url;
        proxy_method POST;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Host $proxy_host;
        proxy_set_header Content-Type "application/json";
        proxy_set_body '{"service":"$wake_service"}';
        proxy_http_version 1.1;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
        proxy_intercept_errors off;
        proxy_cache service_wake;
        proxy_cache_methods POST;
        proxy_cache_key "$wake_url|$wake_service";
        proxy_cache_valid 200 30s;
        proxy_cache_lock on;
    }

    location = /render-health {
        access_log off;
        return 200 '{"status":"ok","service":"ndith-frontend","git_sha":"${GIT_SHA}"}';
        add_header Content-Type application/json;
    }

    # ---- Backend (api / auth / oauth / health / well-known / metrics) ----
    location = /api/health {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/health/ready {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/health/live {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health/live;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /metrics {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /metrics/prometheus {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/metrics/prometheus;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /monitoring {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/monitoring;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Analytics, Graph, News (longest prefix first) -------------------
    location = /api/v1/analytics {
        set $upstream_analytics "${ANALYTICS_UPSTREAM_URL}";
        proxy_pass $upstream_analytics$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/analytics/ {
        set $upstream_analytics "${ANALYTICS_UPSTREAM_URL}";
        proxy_pass $upstream_analytics$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location = /api/v1/graph {
        set $upstream_graph "${GRAPH_UPSTREAM_URL}";
        proxy_pass $upstream_graph$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/graph/ {
        set $upstream_graph "${GRAPH_UPSTREAM_URL}";
        proxy_pass $upstream_graph$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location = /api/v1/news {
        set $upstream_news "${NEWS_UPSTREAM_URL}";
        proxy_pass $upstream_news$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/news/ {
        set $upstream_news "${NEWS_UPSTREAM_URL}";
        proxy_pass $upstream_news$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ---- Generic /api/* fallthrough → Backend ----------------------------
    location /api/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ---- /oauth/* and /auth/callback/* must reach Backend -----------------
    # The api subdomain now routes to Frontend nginx (was direct to
    # Backend), so OAuth provider redirects (e.g. Spotify, Apple, Google,
    # GitHub) hitting /auth/callback/* MUST be proxied to Backend rather
    # than handled by the SPA. /oauth/* (legacy paths) likewise.
    location /oauth/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location /auth/callback/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # SPA-handled /auth/* (login, signup pages, etc.) — only reached when
    # the path is not /auth/callback/* (longer prefix wins).
    location /auth/ {
        try_files $uri $uri/ /index.html;
    }

    # ---- /.well-known/* — OIDC discovery, JWKS — always Backend ----------
    location /.well-known/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- /health and /health/* — Backend's "real" health endpoints ------
    # Reached when probes hit the apex/api directly without the /api
    # prefix. Forwarded to Backend via Cloud Map.
    location = /health {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        set $upstream_backend "${BACKEND_UPSTREAM_URL}";
        proxy_pass $upstream_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # SPA catch-all — anything not matched above is the Svelte app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
